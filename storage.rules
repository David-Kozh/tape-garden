rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Staging uploads for Sample Packs (500MB limit)
    match /uploads-staging/{userId}/sample-packs/{uploadId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && 
                     (request.resource == null || (request.resource.size < 500 * 1024 * 1024 && request.resource.contentType.matches('application/zip|application/x-zip-compressed|audio/.*|image/.*')));
    }

    // Staging uploads for Beats (200MB limit)
    match /uploads-staging/{userId}/beats/{uploadId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && 
                     (request.resource == null || (request.resource.size < 200 * 1024 * 1024 && request.resource.contentType.matches('audio/.*|application/zip|application/x-zip-compressed|image/.*')));
    }

    // Fallback for any other legacy staging uploads (can be removed later)
    match /uploads-staging/{userId}/{uploadId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Previews can be read by anyone
    match /previews/beats/{beatId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only written by Cloud Function
    }
    
    match /previews/sample-packs/{packId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only written by Cloud Function
    }
    
    // Purchased stems/archives can only be read if authorized (to be implemented)
    // For now, no read access to public/buyers directly via generic path, will use Signed URLs or tighten rules later
    match /purchased/beats/{beatId}/{licenseType}/{allPaths=**} {
      allow read, write: if false; // Accessed via Cloud Functions or signed URLs
    }

    match /purchased/sample-packs/{packId}/{allPaths=**} {
      allow read, write: if false; // Accessed via Cloud Functions or signed URLs
    }

    // Public avatars, writable only by the owner
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
